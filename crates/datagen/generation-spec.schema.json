{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GenerationSpec",
  "description": "Recipe for fake table rows. The same spec always produces the same rows.",
  "type": "object",
  "properties": {
    "columns": {
      "description": "Columns in sheet order, left to right.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/ColumnSpec"
      }
    },
    "locale": {
      "description": "Language and country of names, cities, streets and companies.",
      "$ref": "#/$defs/Locale"
    },
    "rows": {
      "description": "Number of data rows to generate, headers not included.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "seed": {
      "description": "Seed of the random sequence; change it for different rows.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "rows",
    "locale",
    "seed",
    "columns"
  ],
  "$defs": {
    "ColumnKind": {
      "description": "What a column holds, with the options of that kind.",
      "oneOf": [
        {
          "description": "Given name, such as Lucía.",
          "type": "object",
          "properties": {
            "gender": {
              "$ref": "#/$defs/Gender",
              "default": "any"
            },
            "type": {
              "type": "string",
              "const": "first_name"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "description": "Family name, such as Fernández or Gómez Ruiz.",
          "type": "object",
          "properties": {
            "count": {
              "$ref": "#/$defs/LastNameCount",
              "default": "one"
            },
            "type": {
              "type": "string",
              "const": "last_name"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "description": "Given name followed by last names.",
          "type": "object",
          "properties": {
            "gender": {
              "$ref": "#/$defs/Gender",
              "default": "any"
            },
            "last_names": {
              "$ref": "#/$defs/LastNameCount",
              "default": "one"
            },
            "type": {
              "type": "string",
              "const": "full_name"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "description": "Email built from the name columns of the same row, lowercased, without accents or spaces. A missing or empty source gets a made-up name.",
          "type": "object",
          "properties": {
            "domains": {
              "description": "Domains chosen at random, such as gmail.com.",
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 253
              },
              "maxItems": 100,
              "minItems": 1
            },
            "first_name_from": {
              "description": "Header of a first_name or full_name column that gives the first name.",
              "type": [
                "string",
                "null"
              ],
              "default": null
            },
            "format": {
              "$ref": "#/$defs/EmailFormat"
            },
            "last_name_from": {
              "description": "Header of a last_name or full_name column that gives the last name.",
              "type": [
                "string",
                "null"
              ],
              "default": null
            },
            "type": {
              "type": "string",
              "const": "email"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "format",
            "domains"
          ]
        },
        {
          "description": "Phone number. In the pattern # is a digit; \\ escapes.",
          "type": "object",
          "properties": {
            "pattern": {
              "type": "string",
              "examples": [
                "+54 9 11 ####-####"
              ],
              "maxLength": 256,
              "minLength": 1
            },
            "type": {
              "type": "string",
              "const": "phone"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "pattern"
          ]
        },
        {
          "description": "Street and number.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "street_address"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "city"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "description": "Made-up company name with a legal suffix.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "company"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "description": "Whole number between min and max, both included.",
          "type": "object",
          "properties": {
            "max": {
              "type": "integer",
              "format": "int64"
            },
            "min": {
              "type": "integer",
              "format": "int64"
            },
            "type": {
              "type": "string",
              "const": "integer"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "min",
            "max"
          ]
        },
        {
          "description": "Number between min and max with a fixed count of decimal places.",
          "type": "object",
          "properties": {
            "max": {
              "type": "number",
              "format": "double"
            },
            "min": {
              "type": "number",
              "format": "double"
            },
            "places": {
              "type": "integer",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "decimal"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "min",
            "max",
            "places"
          ]
        },
        {
          "description": "Date between from and to, both included.",
          "type": "object",
          "properties": {
            "from": {
              "$ref": "#/$defs/Date"
            },
            "to": {
              "$ref": "#/$defs/Date"
            },
            "type": {
              "type": "string",
              "const": "date"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "from",
            "to"
          ]
        },
        {
          "description": "TRUE or FALSE.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "boolean"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "description": "One of the listed values, optionally weighted.",
          "type": "object",
          "properties": {
            "options": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ListOption"
              },
              "maxItems": 10000,
              "minItems": 1
            },
            "type": {
              "type": "string",
              "const": "one_of"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "options"
          ]
        },
        {
          "description": "start, start + step, start + 2 * step, ... by row.",
          "type": "object",
          "properties": {
            "start": {
              "type": "integer",
              "format": "int64",
              "default": 1
            },
            "step": {
              "type": "integer",
              "format": "int64",
              "default": 1
            },
            "type": {
              "type": "string",
              "const": "sequential_id"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "description": "Random version 4 UUID.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "uuid"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "description": "Lorem ipsum sentence with a word count in the range.",
          "type": "object",
          "properties": {
            "max_words": {
              "type": "integer",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            },
            "min_words": {
              "type": "integer",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "lorem"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "min_words",
            "max_words"
          ]
        },
        {
          "description": "Code from a pattern: A is a capital letter, # a digit, \\ escapes, anything else is kept.",
          "type": "object",
          "properties": {
            "pattern": {
              "type": "string",
              "examples": [
                "AAA-####"
              ],
              "maxLength": 256,
              "minLength": 1
            },
            "type": {
              "type": "string",
              "const": "pattern"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "pattern"
          ]
        }
      ]
    },
    "ColumnSpec": {
      "type": "object",
      "properties": {
        "blanks": {
          "description": "Share of rows left empty, chosen at random.",
          "$ref": "#/$defs/Percent",
          "default": 0
        },
        "header": {
          "description": "Header text. Email columns refer to name columns by it.",
          "type": "string",
          "maxLength": 255
        },
        "kind": {
          "$ref": "#/$defs/ColumnKind"
        },
        "unique": {
          "description": "Every non-empty cell differs. Fails when too few values exist.",
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false,
      "required": [
        "header",
        "kind"
      ]
    },
    "Date": {
      "description": "Calendar date written as yyyy-mm-dd, from 1900-01-01 to 9999-12-31.",
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "EmailFormat": {
      "oneOf": [
        {
          "description": "lucia.fernandez",
          "type": "string",
          "const": "first_dot_last"
        },
        {
          "description": "luciafernandez",
          "type": "string",
          "const": "first_last"
        },
        {
          "description": "lfernandez",
          "type": "string",
          "const": "initial_last"
        }
      ]
    },
    "Gender": {
      "type": "string",
      "enum": [
        "any",
        "female",
        "male"
      ]
    },
    "LastNameCount": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "one",
            "two"
          ]
        },
        {
          "description": "Mostly one, sometimes two.",
          "type": "string",
          "const": "one_or_two"
        }
      ]
    },
    "ListOption": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string",
          "maxLength": 255,
          "minLength": 1
        },
        "weight": {
          "description": "Relative frequency; 2 appears twice as often as 1.",
          "type": "integer",
          "format": "uint32",
          "default": 1,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "value"
      ]
    },
    "Locale": {
      "type": "string",
      "enum": [
        "es-AR",
        "en-US"
      ]
    },
    "Percent": {
      "description": "Whole percentage from 0 to 100.",
      "type": "integer",
      "maximum": 100,
      "minimum": 0
    }
  }
}
